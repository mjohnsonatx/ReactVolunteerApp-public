# Copy to .env.<firebase-project-id> and use values for that same project.
# These settings are public routing/configuration values, not credentials.
WATERSHED_SITE_URL=https://replace-with-project.web.app
WATERSHED_WEB_APP_ID=1:000000000000:web:replace-me
WATERSHED_EMAIL_ENABLED=false

# Required only when email delivery is deliberately enabled. The SMTP password
# remains in Google Secret Manager as BREVO_SMTP_KEY and never belongs here.
BREVO_SMTP_LOGIN=smtp-login@example.com
