# Firebase web SDK identifiers are public client configuration, not secrets.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:replace-me
VITE_FIREBASE_MEASUREMENT_ID=

# App Check uses a public site key. Never put a debug token in this example.
VITE_RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
VITE_RECAPTCHA_PROVIDER=recaptcha-v3

# Optional public Web Push key.
VITE_FIREBASE_VAPID_KEY=

# Safe defaults for a real development project.
VITE_USE_FIREBASE_EMULATORS=false
VITE_LOCAL_EMAIL_AUTO_VERIFY=false

# Optional desktop overrides. The desktop renderer reads this same env file.
VITE_FIREBASE_DESKTOP_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
VITE_PUBLIC_SITE_URL=
VITE_APPCHECK_TOKEN_ENDPOINT=
